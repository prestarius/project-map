{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prestarius/project-map/project-map.schema.json",
  "title": "Project Map",
  "type": "object",
  "required": [
    "version",
    "project",
    "views",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "views"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "in_progress",
              "needs_review",
              "blocked",
              "done"
            ]
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "parentId": {
            "type": "string"
          },
          "views": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "required",
                "state"
              ],
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "state": {
                  "enum": [
                    "pass",
                    "fail",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "detail": {
                  "type": "string"
                },
                "collector": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "path_exists",
                        "command",
                        "git_clean",
                        "github_actions"
                      ]
                    },
                    "path": {
                      "type": "string"
                    },
                    "command": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    },
                    "timeoutSeconds": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "conclusion": {
                      "enum": [
                        "success",
                        "failure",
                        "cancelled",
                        "timed_out"
                      ]
                    }
                  },
                  "additionalProperties": true
                },
                "provenance": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "kind",
                      "url",
                      "label"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "ref": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "depends_on",
              "contains",
              "implements",
              "blocks",
              "relates_to"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
